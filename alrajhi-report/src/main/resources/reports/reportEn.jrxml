				<text><![CDATA[
This certification pertains solely to the financing debt mentioned above, as of the time and date of issuance. It does not extend to:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="130" width="560" height="50" uuid="b588f657-aab9-4747-a7d9-b9a7ac634012"/>
